# Copy this file to .env and fill in the values, OR paste them into your
# NexCloud (Pterodactyl) panel → Variables. Panel values override this file.

# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-telegram-bot-token

# Turso cloud database (SQL over HTTPS — no extra packages needed)
# libsql:// URLs are accepted and rewritten to https:// automatically.
TURSO_DATABASE_URL=libsql://your-db-your-org.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Optional: how often to push a local DB backup to Turso (seconds)
TURSO_BACKUP_INTERVAL=300
