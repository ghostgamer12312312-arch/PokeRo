# Copy this file to .env and fill in the values, OR paste them into your
# NexCloud (Pterodactyl) panel → Files → .env (or Variables tab).
# Panel/env values override anything here. NEVER commit the real .env.

# ── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=123456:ABC-your-telegram-bot-token

# ── Turso cloud database (SQL over HTTPS — no extra packages needed) ────────
# libsql:// URLs are accepted and rewritten to https:// automatically.
TURSO_DATABASE_URL=libsql://your-db-your-org.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here
# How often to push a local DB backup to Turso (seconds)
TURSO_BACKUP_INTERVAL=300

# ── Owner / Admin IDs ───────────────────────────────────────────────────────
# Your own Telegram numeric ID. Comma or space separated for multiple owners.
OWNER_ID=123456789
# Extra admins (optional, comma/space separated). Owner is always admin.
ADMIN_IDS=
# Head admins (optional; defaults to ADMIN_IDS if empty)
HEAD_ADMIN_IDS=

# ── Notification targets (default to the owner ID if empty) ─────────────────
# QUERY_ADMIN_GC accepts a numeric chat id (e.g. -1001234567890) or @username.
# Telegram invite links (https://t.me/+...) cannot be used here — the bot must
# be a member of the group and you use its numeric id.
QUERY_ADMIN_GC=
RENAME_ADMIN_GC=
CAPTCHA_POLICE_CHAT_ID=
